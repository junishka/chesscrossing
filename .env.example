# Copy to .env. Nothing here is required to run the game without a narrator.

# Port for the local server (serves the game and the narrator API).
PORT=3000

# Narrator backend: anthropic | cli | mock
#   anthropic  Anthropic SDK. Needs ANTHROPIC_API_KEY, or an `ant auth login` profile.
#   cli        The Claude CLI in print mode. Uses your existing Claude login. Needs `claude` on PATH.
#   mock       Canned lines from docs/voice.md. No network. Useful for development.
NARRATOR_BACKEND=anthropic

# Model for the narrator. Opus 5.5 is the intended voice.
NARRATOR_MODEL=claude-opus-5-5

# Effort for the narrator. low | medium | high. Conversation does well at low.
NARRATOR_EFFORT=low

# Server-side refusal fallbacks (Anthropic backend only). true | false
NARRATOR_FALLBACKS=true

# Only for the anthropic backend.
# ANTHROPIC_API_KEY=

# Only for the cli backend. Path to the claude executable if not on PATH.
# CLAUDE_CLI_PATH=claude
